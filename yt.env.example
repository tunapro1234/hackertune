# yt.env olarak kopyala; app/config.py varsayılanlarını ezer. Değiştirince: systemctl restart yt-web yt-worker
YT_PORT=3030
YT_PUBLIC_URL=https://yt.example.com
# Değerlendirme arka ucu: agents (bp ile açılan Claude Code agent'ları) ya da claude-p (headless claude -p)
YT_BACKEND=agents
YT_AGENTS=youtube-eval-1:deep,youtube-eval-2:deep,youtube-triage:triage+fit+translate,youtube-curator:chanrev+curate
YT_DEEP_MAX_PER_DAY=100
YT_QUALITY_THRESHOLD=6
YT_BUDGET_CHAT_USD_DAY=5
# İkili dosya yolları (varsayılanlar root kurulumu içindir)
#YT_CLAUDE_BIN=/root/.local/bin/claude
#YT_YTDLP_BIN=/usr/local/bin/yt-dlp
#YT_BP_BIN=/usr/local/bin/bp
#YT_VAR=/srv/youtube/var
# Modeller ve bütçeler
#YT_MODEL_TRIAGE=claude-haiku-5-5
#YT_MODEL_DEEP=claude-sonnet-5-5
#YT_MODEL_FIT=claude-haiku-5-5
#YT_MODEL_CHAT=claude-sonnet-5-5
#YT_DEEP_PARALLEL=2
#YT_BUDGET_EVAL_USD_DAY=6
# Eski alan adları (buraya gelen istek YT_PUBLIC_URL'e yönlenir, oturum taşınır)
#YT_OLD_HOSTS=
#YT_CURATE_MAX_PER_DAY=30
